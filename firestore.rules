rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /routes/{routeId} {
      allow read: if true;
      allow write: if false;
    }

    match /liveTrips/{tripId} {
      allow read: if resource.data.status == 'active';
      allow create: if signedIn()
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.city is string
        && request.resource.data.line is string
        && request.resource.data.line.size() > 0
        && request.resource.data.line.size() <= 80
        && request.resource.data.location == null;
      allow update: if signedIn()
        && resource.data.driverUid == request.auth.uid
        && request.resource.data.driverUid == resource.data.driverUid
        && request.resource.data.city == resource.data.city
        && request.resource.data.line == resource.data.line
        && request.resource.data.status in ['active', 'ended'];
      allow delete: if false;
    }

    match /passengerRequests/{requestId} {
      allow read: if signedIn() && resource.data.status == 'active';
      allow create: if signedIn()
        && request.resource.data.passengerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.city is string
        && request.resource.data.line is string
        && request.resource.data.stop is string
        && request.resource.data.stop.size() > 0
        && request.resource.data.stop.size() <= 120
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 1800000;
      allow update: if signedIn()
        && resource.data.passengerUid == request.auth.uid
        && request.resource.data.passengerUid == resource.data.passengerUid
        && request.resource.data.city == resource.data.city
        && request.resource.data.line == resource.data.line
        && request.resource.data.status == 'active'
        && request.resource.data.stop is string
        && request.resource.data.stop.size() > 0
        && request.resource.data.stop.size() <= 120
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 1800000;
      allow delete: if signedIn() && resource.data.passengerUid == request.auth.uid;
    }
  }
}